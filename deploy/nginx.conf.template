# Render with scripts/render_nginx.py. All tokens are required. Include in http{}.
map $http_upgrade $gpu_monitor_connection {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __SERVER_NAME__;
    ssl_certificate __CERTIFICATE__;
    ssl_certificate_key __PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:GPU_MONITOR_TLS:1m;
    auth_basic "GPU Monitor";
    auth_basic_user_file __HTPASSWD__;
    client_max_body_size 1k;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $gpu_monitor_connection;
        proxy_read_timeout 75s;
        proxy_send_timeout 10s;
        proxy_buffering off;
    }
}
